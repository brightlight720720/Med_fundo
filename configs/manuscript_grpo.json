{
  "base_model": "google/medgemma-4b-it",
  "dataset_manifest": "data/grpo_split_manifest.csv",
  "sft_adapter_path": "outputs/sft",
  "seed": null,
  "max_steps": 500,
  "learning_rate": 3e-5,
  "per_device_train_batch_size": 2,
  "gradient_accumulation_steps": 18,
  "lr_scheduler_type": "cosine",
  "weight_decay": 0.01,
  "bf16": true,
  "num_generations": 4,
  "num_iterations": 4,
  "temperature": 0.5,
  "max_completion_length": 320,
  "beta": 0.04,
  "epsilon": 0.15,
  "epsilon_high": 0.3,
  "reward_weights": {"diagnosis": 0.5, "format": 0.1, "explanation_diagnosis": 0.4},
  "lora_r": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.05,
  "lora_targets": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
  "output_dir": "outputs/grpo"
}
